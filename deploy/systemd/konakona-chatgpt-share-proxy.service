[Unit]
Description=Kona Toolbox API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/konakona52-chatgpt-share-proxy
ExecStart=/usr/bin/node --max-old-space-size=256 /opt/konakona52-chatgpt-share-proxy/index.mjs
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
MemoryMax=512M
CPUQuota=100%
UMask=0077
Environment=NODE_ENV=production
Environment=ALLOWED_ORIGINS=https://tools.konakona52.com,https://tools.konakona.dev

[Install]
WantedBy=multi-user.target
